rules_version = '2';

// Roles: owner (everything, manages people), editor (list, purchases, receipts, spending),
// requester (sees the list, can only request items).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function account(id) { return get(/databases/$(database)/documents/accounts/$(id)).data; }
    function isMember(id) { return signedIn() && request.auth.uid in account(id).memberUids; }
    function roleIn(id) { return account(id).members[request.auth.uid].role; }
    function canEdit(id) { return isMember(id) && roleIn(id) in ['owner', 'editor']; }
    function isOwner(id) { return isMember(id) && roleIn(id) == 'owner'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /accounts/{accountId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner';

      allow update: if
        // Owners manage the account and its people.
        (signedIn() && resource.data.members[request.auth.uid].role == 'owner'
          && request.auth.uid in request.resource.data.memberUids)
        // Editors may change settings only.
        || (signedIn() && resource.data.members[request.auth.uid].role == 'editor'
          && changed().hasOnly(['settings']))
        // Accepting an invite: add yourself, with exactly the invited role.
        || joining(accountId);

      allow delete: if signedIn() && resource.data.members[request.auth.uid].role == 'owner';

      function joining(accountId) {
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.lastInvite)).data;
        return signedIn()
          && request.auth.token.email_verified == true
          && !(request.auth.uid in resource.data.memberUids)
          && changed().hasOnly(['members', 'memberUids', 'lastInvite'])
          && invite.accountId == accountId
          && invite.email == myEmail()
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid].role == invite.role;
      }

      match /items/{itemId} {
        allow read: if isMember(accountId);
        allow create: if canEdit(accountId)
          || (isMember(accountId) && request.resource.data.status == 'requested' && request.resource.data.addedBy == request.auth.uid);
        allow update: if canEdit(accountId)
          || (isMember(accountId)
            && resource.data.status in ['stocked', 'snoozed']
            && request.resource.data.status == 'requested'
            && changed().hasOnly(['status', 'qty', 'unit', 'store', 'category', 'urgent', 'needBy', 'addedAt', 'addedBy', 'addedByName', 'lastPrice']));
        allow delete: if canEdit(accountId);
      }

      match /batches/{id} {
        allow read: if isMember(accountId);
        allow write: if canEdit(accountId);
      }

      match /{coll}/{id} {
        // purchases, receipts, receiptImages: spending data for owners and editors only.
        allow read, write: if coll in ['purchases', 'receipts', 'receiptImages'] && canEdit(accountId);
      }
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (resource.data.email == myEmail() || resource.data.invitedByUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.role in ['owner', 'editor', 'requester']
        && account(request.resource.data.accountId).members[request.auth.uid].role == 'owner';
      allow delete: if signedIn() && (resource.data.email == myEmail() || resource.data.invitedByUid == request.auth.uid
        || account(resource.data.accountId).members[request.auth.uid].role == 'owner');
    }
  }
}
