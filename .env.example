# Copy to .env.local for local development, and add the same names in Netlify:
# Site configuration > Environment variables. These values are not secret;
# Firebase web config is meant to be public and is protected by the security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key, needed for App Check, which Firebase AI Logic enforces
VITE_RECAPTCHA_SITE_KEY=
# Optional
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_APP_NAME=Shopping List
# Server only. Free key from serpapi.com for automatic store prices. Set it in Netlify,
# never with a VITE_ prefix, so the browser never sees it.
SERPAPI_KEY=
